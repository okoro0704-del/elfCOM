# Production web / Capacitor build — never put signing secrets or JWT HMAC secrets here.
VITE_ELFCOM_BASE_URL=https://elfcomnode-production.up.railway.app
VITE_TRUSTID_BASE_URL=https://lucid-integrity-production.up.railway.app
VITE_TRUSTID_WEB_ORIGIN=https://trustedid.netlify.app
# Optional override for APK OAuth return (default: com.elfcom.app://auth/callback)
# VITE_TRUSTID_NATIVE_REDIRECT=com.elfcom.app://auth/callback

# Do NOT set VITE_ELFCOM_NODE_SECRET in client builds — that secret stays on the server only.
