# Console talks to elfcom-node
# Local: leave empty (Vite proxies /v1 → :8791)
# Netlify: set to your deployed API, e.g. https://elfcom-api.up.railway.app
VITE_ELFCOM_BASE_URL=
# Dev-only: shared HMAC with LIFEOS_JWT_SECRET — never ship to production builds
VITE_ELFCOM_NODE_SECRET=elfcom-dev-node-secret-change-me
VITE_ELFCOM_JWT_ISS=lifeos
VITE_ELFCOM_JWT_AUD=elfcom
VITE_POLL_MS=4000
