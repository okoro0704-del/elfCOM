{
  "name": "@elfcom/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@elfcom/connectors": "*",
    "@elfcom/connectors-core": "*",
    "@elfcom/contract": "*",
    "@elfcom/crypto": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.2.1",
    "jose": "^6.2.7",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "npm run build -w @elfcom/contract && npm run build -w @elfcom/crypto && npm run build -w @elfcom/connectors-core && npm run build -w @elfcom/connectors && prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:migrate": "prisma db push --schema=prisma/schema.prisma --skip-generate && node dist/index.js",
    "start:local": "node --env-file=../../.env dist/index.js",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "test": "tsc -p tsconfig.json && node --import tsx --test src/services/router.service.test.ts src/services/websocket.service.test.ts src/services/primitive.test.ts tests/e2e/hospitalityos-elfcom.test.ts"
  }
}
