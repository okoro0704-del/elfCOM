# ElfCom sovereign node (Phase A)
ELFCOM_PORT=8791
HOST=0.0.0.0
NODE_ENV=development

# 32-byte key: base64, hex, or raw 32-char utf8
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ELFCOM_NODE_MASTER_KEY=0123456789abcdef0123456789abcdef

# Shared with LifeOS ELFCOM_NODE_SECRET — HS256 capability JWTs
LIFEOS_JWT_SECRET=elfcom-dev-node-secret-change-me
LIFEOS_JWT_ISS=lifeos
LIFEOS_JWT_AUD=elfcom

# Session bind TTL (seconds)
SESSION_BIND_TTL_SECONDS=86400

# Dev: allow auto-derived session keys when zk_bind matches HMAC derivation
ELFCOM_DEV_AUTO_BIND=true

# Phase B — Omnichannel (Pillar 3)
CONNECTORS_ENABLED=whatsapp,telegram,email,instagram,x
WHATSAPP_VERIFY_TOKEN=elfcom-dev-verify
# WHATSAPP_APP_SECRET=
# TELEGRAM_WEBHOOK_SECRET=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# X_CONSUMER_SECRET=
# EMAIL_INBOUND_SECRET=
# Route unlinked ingress to this owner in development
ELFCOM_DEV_INGRESS_OWNER=

# Phase C — optional Postgres dual-write (omit = memory only)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elfcom?schema=public
ELFCOM_ROUTER_FALLBACK=whatsapp,telegram,email,instagram,x,dm

# Phase D — Live channel credentials (omit = stub send; ingress still works)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v18.0
# TELEGRAM_BOT_TOKEN=
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@example.com
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# Phase D — TrustID JWKS (optional; LifeOS capability JWT remains primary)
# TRUSTID_JWKS_URL=https://trustid.example/.well-known/jwks.json
# TRUSTID_ISSUER=https://trustid.example
# TRUSTID_AUDIENCE=elfcom

